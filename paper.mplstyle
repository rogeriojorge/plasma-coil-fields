# Shared figure style for the study (validated categorical order: blue, orange, aqua, yellow, magenta)
font.size: 8.5
axes.labelsize: 8.5
axes.titlesize: 8.5
legend.fontsize: 7.2
xtick.labelsize: 7.5
ytick.labelsize: 7.5
axes.edgecolor: 52514e
axes.labelcolor: 0b0b0b
xtick.color: 52514e
ytick.color: 52514e
axes.grid: True
grid.color: dcdad4
grid.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '4a3aa7'])
lines.linewidth: 1.4
lines.markersize: 4.5
legend.frameon: False
savefig.dpi: 200
pdf.fonttype: 42
